[gd_scene format=3]

[ext_resource type="Script" path="res://addons/SmoothScroll/smooth_scroll_container.gd" id="1_scroll"]
[ext_resource type="Script" path="res://addons/SmoothScroll/scroll_damper/expo_scroll_damper.gd" id="2_damper"]

[sub_resource type="Resource" id="Wheel"]
script = ExtResource("2_damper")

[sub_resource type="Resource" id="Drag"]
script = ExtResource("2_damper")

[node name="SmoothScrollContainer" type="ScrollContainer"]
custom_minimum_size = Vector2(800, 350)
horizontal_scroll_mode = 0
script = ExtResource("1_scroll")
wheel_scroll_damper = SubResource("Wheel")
dragging_scroll_damper = SubResource("Drag")
allow_horizontal_scroll = false

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8
